{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "remotion": ["./node_modules/remotion"],
      "ogl": ["./node_modules/ogl"]
    }
  },
  "include": ["src", "scripts/*.ts", "vite.config.ts", "../*.ts", "../*.tsx", "../core", "../meta"],
  "exclude": ["node_modules", "dist", "src/before.tsx", "../RotatingCarousel.tsx", "../TextReveal.tsx", "../TypingEffect.tsx", "../StonkLogoTrace.tsx", "../MotionExamples.tsx"]
}
